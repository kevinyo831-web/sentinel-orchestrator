# Sentinel Orchestrator 環境變數
# 在 Vercel Settings → Environment Variables 設定

# ── 現有 AI 模型 API Keys ──────────────────────────────────────
NEXT_PUBLIC_GEMINI_KEY=your_gemini_key_here
NEXT_PUBLIC_GROK_KEY=your_grok_key_here
NEXT_PUBLIC_PERPLEXITY_KEY=your_perplexity_key_here
NEXT_PUBLIC_OPENAI_KEY=your_openai_key_here
NEXT_PUBLIC_NVIDIA_KEY=your_nvidia_key_here
NEXT_PUBLIC_VERTEX_KEY=your_vertex_key_here
NEXT_PUBLIC_LOCAL_ENDPOINT=http://localhost:11434

# ── HO5 AI 流量網關（選用，部署方式見 deploy/ho5/README.md）──
# 設定後 /api/chat 所有 provider 統一走 HO5 上的 LiteLLM 網關
# （負載均衡、自動重試、降級路由、Redis 響應緩存）
# HO5_GATEWAY_URL=http://100.x.y.z:4000
# HO5_GATEWAY_KEY=sk-ho5-change-me

# ── 富邦證券 API (自動交易模組) ───────────────────────────────
# 申請方式：富邦證券官網 → API 申請 → 專業投資人
FUBON_API_URL=https://api.fubon.com
FUBON_ACCOUNT=your_account_id
FUBON_PASSWORD=your_password
FUBON_CERT_PASSWORD=your_cert_password

# 設為 '1' 啟用模擬下單模式（安全測試，不會真正下單）
FUBON_SIM_MODE=1

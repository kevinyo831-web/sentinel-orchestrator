# HO5 AI 流量網關環境變數
# cp .env.example .env 後填入實際值

# 網關統一金鑰（調用方以 Bearer token 帶入；請改成自己的隨機字串）
LITELLM_MASTER_KEY=sk-ho5-change-me

# 監聽位址：建議設為 Tailscale 內網 IP（執行 `tailscale ip -4` 取得），
# 只讓 Tailnet 內的設備能調用，不暴露公網
HO5_BIND_IP=127.0.0.1

# ── 各家 AI API 金鑰（缺哪家就留空，該 model 調用時才會失敗）──
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=

# Vertex AI（選用；需另掛 GCP 服務帳號 JSON，見 README）
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# 本地 Ollama（跑在 HO5 宿主機上）
OLLAMA_API_BASE=http://host.docker.internal:11434
